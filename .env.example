# ─────────────────────────────────────────────────────────────
# Eltaranisi ERP — example environment file (NO SECRETS HERE)
# Copy to .env and fill in real values. .env must never be committed.
# ─────────────────────────────────────────────────────────────

# HTTP
PORT=8000
HOST=0.0.0.0

# Storage
ERP_DB=./data/erp.db                 # SQLite file (dev / single-node); on Vercel this defaults to /tmp/eltaranisi-erp/erp.db
ERP_CREDENTIALS_FILE=./data/dev-credentials.txt   # dev demo logins (auto-falls back to /tmp when read-only)
ERP_UPLOAD_DIR=./data/uploads        # must be OUTSIDE any public web root
ERP_SESSION_HOURS=12
ERP_PBKDF2_ITERATIONS=240000

# Security (generate with: python3 -c "import secrets;print(secrets.token_urlsafe(48))")
ERP_SECRET_KEY=
ERP_LOGIN_MAX_ATTEMPTS=8
ERP_LOGIN_LOCKOUT_MINUTES=15

# Seed (development only — never run against production data)
ERP_SEED_DEMO_DATA=true

# Backups
BACKUP_DIR=./backups
RETENTION_DAYS=30
BACKUP_AGE_RECIPIENT=                # age public key for encrypted backups
# BACKUP_GPG_RECIPIENT=backups@example.com

# Optional external AI provider (disabled by default; requires policy + consent)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
