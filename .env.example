# ─────────────────────────────────────────────────────────────
# ELTARANISI ERP — example environment file (NO SECRETS HERE)
# Copy to .env and fill in real values. .env must never be committed.
# ─────────────────────────────────────────────────────────────

# HTTP
PORT=8000
HOST=0.0.0.0

# Storage
ERP_DB=./data/erp.db                 # SQLite file (dev / single-node); on Vercel this defaults to /tmp/eltaranisi-erp/erp.db
ERP_CREDENTIALS_FILE=./data/dev-credentials.txt   # dev demo logins (auto-falls back to /tmp when read-only)
ERP_UPLOAD_DIR=./data/uploads        # must be OUTSIDE any public web root
ERP_SESSION_HOURS=12

# ── Database backend ─────────────────────────────────────────────
# sqlite  = local file (ERP_DB). Perfect for a single server / dev.
# d1      = Cloudflare D1 (managed SQLite in Cloudflare's cloud). Data is kept
#           outside the server, so it survives restarts, redeploys and a Vercel
#           cold start. Set up with: python3 scripts/setup_cloudflare_d1.py
ERP_DB_BACKEND=sqlite
# CF_ACCOUNT_ID=                   # Cloudflare account id (32 hex chars)
# CF_D1_DATABASE_ID=               # uuid from `wrangler d1 list` (or the setup script)
# CF_D1_DATABASE=eltaranisi-erp    # alternative: resolve the database by name
# CF_API_TOKEN=                    # token with Account → D1 → Edit. NEVER commit it.
# CF_D1_API_BASE=https://api.cloudflare.com/client/v4
# ERP_EPHEMERAL_AUTH=0             # 1 only when the database itself is temporary
ERP_PBKDF2_ITERATIONS=240000

# Security (generate with: python3 -c "import secrets;print(secrets.token_urlsafe(48))")
# Used to HMAC-sign bearer tokens. REQUIRED on serverless hosts (Vercel) where the
# SQLite file — and therefore the session table — is recreated per instance.
ERP_SECRET_KEY=
ERP_LOGIN_MAX_ATTEMPTS=8
ERP_LOGIN_LOCKOUT_MINUTES=15

# Documents (PDF)
# Arabic typeface embedded in every PDF (statement / invoice / report).
# Any TTF dropped into assets/fonts/ can be named here; it falls back to
# NotoSansArabic.ttf (then Amiri-Regular.ttf) if the file is missing.
ERP_PDF_FONT=NotoSansArabic.ttf

# Seed (development only — never run against production data)
ERP_SEED_DEMO_DATA=true

# Backups
BACKUP_DIR=./backups
RETENTION_DAYS=30
BACKUP_AGE_RECIPIENT=                # age public key for encrypted backups
# BACKUP_GPG_RECIPIENT=backups@example.com

# Optional external AI provider (disabled by default; requires policy + consent)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
